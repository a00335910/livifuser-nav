<?xml version="1.0"?>
<package format="3">
  <name>livifuser_sim_eval</name>
  <version>0.1.0</version>
  <description>
    Closed-loop evaluation entry points for LiViFuser-Nav. Kept out of
    livifuser_sim because that package's setup.py is byte-frozen by the
    simulation recollection preregistration freeze.
  </description>
  <maintainer email="maintainer@example.com">LiViFuser-Nav Team</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>livifuser_interfaces</exec_depend>
  <exec_depend>livifuser_sim</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
