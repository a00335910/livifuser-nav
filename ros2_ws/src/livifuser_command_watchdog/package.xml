<?xml version="1.0"?>
<package format="3">
  <name>livifuser_command_watchdog</name>
  <version>0.1.0</version>
  <description>Fail-safe stamped-intent bridge for LiViFuser-Nav data acquisition.</description>
  <maintainer email="maintainer@example.com">LiViFuser-Nav Team</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>livifuser_interfaces</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-tk</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosbag2</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
